FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    libprotobuf-dev \
    protobuf-compiler-grpc \
    libgrpc++-dev \
    libre2-dev \
    libabsl-dev \
    librdkafka-dev \
    libhiredis-dev \
    libpq-dev \
    ca-certificates \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY . /src

RUN mkdir -p /src/api/grpc/generated && \
    protoc \
        -I /src/api/grpc \
        --cpp_out=/src/api/grpc/generated \
        --grpc_out=/src/api/grpc/generated \
        --plugin=protoc-gen-grpc=/usr/bin/grpc_cpp_plugin \
        /src/api/grpc/nexusflow.proto && \
    test -f /src/api/grpc/generated/nexusflow.pb.cc && \
    test -f /src/api/grpc/generated/nexusflow.pb.h && \
    test -f /src/api/grpc/generated/nexusflow.grpc.pb.cc && \
    test -f /src/api/grpc/generated/nexusflow.grpc.pb.h && \
    echo "LINUX GRPC PROTOBUF GENERATION: PASS"

RUN mkdir -p /src/observability/opentelemetry/generated && \
    protoc \
        -I /src/observability/opentelemetry/proto \
        --cpp_out=/src/observability/opentelemetry/generated \
        /src/observability/opentelemetry/proto/trace.proto \
        /src/observability/opentelemetry/proto/trace_service.proto && \
    test -f /src/observability/opentelemetry/generated/trace.pb.cc && \
    test -f /src/observability/opentelemetry/generated/trace.pb.h && \
    test -f /src/observability/opentelemetry/generated/trace_service.pb.cc && \
    test -f /src/observability/opentelemetry/generated/trace_service.pb.h && \
    echo "LINUX OTLP PROTOBUF GENERATION: PASS"

RUN git clone --depth 1 --branch 1.3.15 https://github.com/sewenew/redis-plus-plus.git /tmp/redis-plus-plus && \
    cmake -S /tmp/redis-plus-plus -B /tmp/redis-plus-plus/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DREDIS_PLUS_PLUS_BUILD_TEST=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/redis-plus-plus/build --parallel && \
    cmake --install /tmp/redis-plus-plus/build && \
    ldconfig

RUN mkdir -p /src/build-linux && \
    cmake -S /src -B /src/build-linux \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DNEXUSFLOW_BUILD_TESTS=OFF \
        -DCMAKE_PREFIX_PATH="/usr/lib/x86_64-linux-gnu/cmake/protobuf;/usr/lib/x86_64-linux-gnu/cmake/grpc;/usr/lib/x86_64-linux-gnu/cmake/absl" && \
    cmake --build /src/build-linux --parallel && \
    NEXUSFLOW_BIN="$(find /src/build-linux -type f -name nexusflow -print -quit)" && \
    NEXUSFLOW_SERVICE_BIN="$(find /src/build-linux -type f -name nexusflow_service -print -quit)" && \
    test -n "$NEXUSFLOW_BIN" && \
    test -n "$NEXUSFLOW_SERVICE_BIN" && \
    test -f "$NEXUSFLOW_BIN" && \
    test -f "$NEXUSFLOW_SERVICE_BIN" && \
    echo "NEXUSFLOW BINARY: $NEXUSFLOW_BIN" && \
    echo "NEXUSFLOW SERVICE BINARY: $NEXUSFLOW_SERVICE_BIN" && \
    cp "$NEXUSFLOW_BIN" /tmp/nexusflow && \
    cp "$NEXUSFLOW_SERVICE_BIN" /tmp/nexusflow_service && \
    test -x /tmp/nexusflow && \
    test -x /tmp/nexusflow_service

FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libstdc++6 \
    libgcc-s1 \
    libssl3 \
    libprotobuf32 \
    libgrpc++1.51 \
    libre2-10 \
    libhiredis1.1.0 \
    libpq5 \
    librdkafka1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/nexusflow /app/nexusflow
COPY --from=builder /tmp/nexusflow_service /app/nexusflow_service
COPY --from=builder /usr/local/lib/libredis++.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libhiredis.so* /usr/local/lib/

RUN ldconfig

RUN useradd --create-home --shell /usr/sbin/nologin nexusflow && \
    mkdir -p /app/benchmarks/results && \
    chown -R nexusflow:nexusflow /app

USER nexusflow

WORKDIR /app

EXPOSE 8080 9100

ENTRYPOINT ["/app/nexusflow_service"]












FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        libstdc++6 \
        libprotobuf-dev \
        libgrpc++-dev \
        libabsl-dev \
        librdkafka1 \
        libhiredis1.1.0 \
        libpq5 \
        && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/lib/libredis++.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libhiredis.so* /usr/local/lib/
RUN ldconfig
WORKDIR /app

COPY --from=builder /src/build-linux/app/nexusflow /app/nexusflow

RUN useradd --create-home --shell /usr/sbin/nologin nexusflow && \
    chown -R nexusflow:nexusflow /app

USER nexusflow

EXPOSE 9100

ENTRYPOINT ["/app/nexusflow"]





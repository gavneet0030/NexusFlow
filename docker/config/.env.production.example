NEXUSFLOW_ENV=production

NEXUSFLOW_LOG_LEVEL=info

NEXUSFLOW_WORKERS=4
NEXUSFLOW_QUEUE_CAPACITY=100000

NEXUSFLOW_SLA_P99_US=1000

NEXUSFLOW_REDIS_HOST=redis
NEXUSFLOW_REDIS_PORT=6379

NEXUSFLOW_POSTGRES_HOST=postgres
NEXUSFLOW_POSTGRES_PORT=5432
NEXUSFLOW_POSTGRES_DATABASE=frip
NEXUSFLOW_POSTGRES_USER=postgres
NEXUSFLOW_POSTGRES_PASSWORD=CHANGE_ME

NEXUSFLOW_KAFKA_BROKERS=redpanda:9092
NEXUSFLOW_KAFKA_TOPIC=nexusflow.events

NEXUSFLOW_PROMETHEUS_PORT=9100

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

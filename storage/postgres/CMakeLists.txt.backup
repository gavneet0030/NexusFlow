add_library(nexusflow_postgres
    postgres_store.cpp
)

target_include_directories(nexusflow_postgres
    PUBLIC
        ${CMAKE_SOURCE_DIR}
        C:/vcpkg/installed/x64-windows/include
)

target_link_directories(nexusflow_postgres
    PUBLIC
        C:/vcpkg/installed/x64-windows/lib
)

target_link_libraries(nexusflow_postgres
    PUBLIC
        libpq
)

target_compile_features(nexusflow_postgres
    PUBLIC
        cxx_std_20
)

if (WIN32)
    add_custom_command(
        TARGET nexusflow_postgres
        POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "C:/vcpkg/installed/x64-windows/bin/libpq.dll"
            "$<TARGET_FILE_DIR:nexusflow_postgres>/libpq.dll"
        VERBATIM
    )
endif()

if (BUILD_TESTING)
    add_executable(postgres_store_test
        ${CMAKE_SOURCE_DIR}/tests/integration/storage/postgres_store_test.cpp
    )

    target_link_libraries(postgres_store_test
        PRIVATE
            nexusflow_postgres
            nexusflow_core
    )

    add_test(
        NAME postgres_store_test
        COMMAND postgres_store_test
    )
endif()
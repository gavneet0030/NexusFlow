# Template only. Replace values using your local secret manager.
# Do not put production passwords or tokens in this file.
NEXUSFLOW_ENV=development
NEXUSFLOW_LOG_LEVEL=info
NEXUSFLOW_WORKERS=4
NEXUSFLOW_QUEUE_CAPACITY=100000
NEXUSFLOW_SCHEDULER_MODE=adaptive
NEXUSFLOW_METRICS_ENABLED=true
NEXUSFLOW_TRACING_ENABLED=true

# Configure these only if the application supports the variables.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=frip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=